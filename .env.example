# Variáveis para docker-compose.prod.yml (Dokploy).
# Configurar cada uma na aba "Environment" do Dokploy — nunca commitar valores reais.

# Postgres
POSTGRES_USER=redetrade
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=redetrade

# Redis
REDIS_PASSWORD=change_me_strong_password

# JWT — gerar com: openssl rand -hex 32
JWT_SECRET=change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Senha do superadmin criado pelo seed — obrigatória em produção (sem fallback)
SEED_ADMIN_PASSWORD=change_me

# Backblaze B2 (upload de imagens)
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=redetrade
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_PUBLIC_URL=https://f005.backblazeb2.com/file/redetrade
